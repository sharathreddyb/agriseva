    {
      "name": "Equipment Rentals",
      "item": [
        {
          "name": "Create Rental",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rental created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "    pm.collectionVariables.set(\"rentalId\", response.id);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const startDate = new Date();\r",
                  "startDate.setDate(startDate.getDate() + 2);\r",
                  "\r",
                  "const endDate = new Date();\r",
                  "endDate.setDate(endDate.getDate() + 4);\r",
                  "\r",
                  "function formatDate(date) {\r",
                  "    return date.toISOString().split(\"T\")[0];\r",
                  "}\r",
                  "\r",
                  "pm.variables.set(\r",
                  "    \"rentalStartDate\",\r",
                  "    formatDate(startDate)\r",
                  ");\r",
                  "\r",
                  "pm.variables.set(\r",
                  "    \"rentalEndDate\",\r",
                  "    formatDate(endDate)\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": {{equipmentId}},\n  \"startDate\": \"{{rentalStartDate}}\",\n  \"endDate\": \"{{rentalEndDate}}\",\n  \"farmerNote\": \"Need the equipment for field preparation.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/rentals",
              "host": [
